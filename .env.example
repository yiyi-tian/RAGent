# 阿里云百炼北京地域业务空间的兼容模式 Base URL，不含 /embeddings。
# 格式：https://<业务空间ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
RAGENT_EMBEDDING_BASE_URL=

# 百炼模型和 API Key；请在本地 .env 中填写密钥。
RAGENT_EMBEDDING_MODEL=text-embedding-v4
RAGENT_EMBEDDING_API_KEY=

# Qdrant 本机地址与集合名称；使用受保护的服务时填写 API Key。
RAGENT_QDRANT_URL=http://127.0.0.1:6333
RAGENT_QDRANT_COLLECTION=linux_manual_v4
RAGENT_QDRANT_API_KEY=
# context 为默认策略，自动识别段落与条目两种粒度；vector 仅作单路向量检索。
RAGENT_RETRIEVAL_STRATEGY=context

# DeepSeek 模型适配器配置；当前 Mock 模型不会读取这些变量。
# 官方接口说明：https://api-docs.deepseek.com/
RAGENT_BASE_URL=https://api.deepseek.com
RAGENT_MODEL=deepseek-flash
RAGENT_API_KEY=
RAGENT_MODEL_TIMEOUT_SECONDS=60
RAGENT_MAX_OUTPUT_TOKENS=2048

# 模型并发上限，测量后按账号与机器能力调整。
RAGENT_MODEL_CONCURRENCY=32
# 固定HTTP工作进程数，范围1至4；模型并发与检索线程是整组总量，按进程均分。
RAGENT_AGENT_WORKERS=1
# 独立检索线程池，限制 Embedding 和本地检索并发。
RAGENT_RETRIEVAL_WORKERS=8

# 默认国内模型接口直连，避免系统代理增加传输环节；其他接口按实际域名补充。
NO_PROXY=localhost,127.0.0.1,::1,api.deepseek.com,.aliyuncs.com
no_proxy="$NO_PROXY"

# 可选：只读C执行器绝对路径，默认使用仓库下 build/ragent-executor。
# RAGENT_EXECUTOR_PATH=/绝对路径/ragent-executor

# CMD执行配置：local为只读诊断；sandbox增加连接级临时文件工具。
RAGENT_COMMANDS=local
# sandbox首次部署：bash scripts/setup-sandbox.sh；常规启动不重建镜像。
# RAGENT_SANDBOX_SOCKET=/run/user/1000/ragent-sandbox-docker.sock
# RAGENT_SANDBOX_STATE=/run/user/1000/ragent-sandbox/state.json
# RAGENT_SANDBOX_EXECUTOR=/绝对路径/build/ragent-sandbox
